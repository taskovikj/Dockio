# Dockio local/dev configuration

# Local state directory. Installed VPSs use /var/lib/dockio-panel.
DIO_DATA_DIR=.data-dockio-panel

# Panel bind config.
DIO_BIND_HOST=127.0.0.1
DIO_PORT=3000

# Optional first-admin setup token for local testing.
# Leave empty to skip setup-token enforcement in local dev.
DIO_SETUP_TOKEN=

# Optional trusted network guard.
# In production, prefer firewall rules. This guard is useful behind trusted proxies only.
DIO_TRUSTED_NETWORK_ONLY=false
DIO_TRUSTED_CIDRS=127.0.0.1/32

# Runtime user used by installed service actions.
DIO_RUN_USER=dockio
