# Supavibe Panel local/dev configuration

# Local state directory. Installed VPSs use /var/lib/supavibe-panel.
SVP_DATA_DIR=.data-supavibe-panel

# Panel bind config.
SVP_BIND_HOST=127.0.0.1
SVP_PORT=3000

# Optional first-admin setup token for local testing.
# Leave empty to skip setup-token enforcement in local dev.
SVP_SETUP_TOKEN=

# Optional trusted network guard.
# In production, prefer firewall rules. This guard is useful behind trusted proxies only.
SVP_TRUSTED_NETWORK_ONLY=false
SVP_TRUSTED_CIDRS=127.0.0.1/32

# Runtime user used by installed service actions.
SVP_RUN_USER=supavibe
